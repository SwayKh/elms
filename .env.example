# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# For hosted/serverless providers (Neon, Supabase, …) use the pooler/transaction
# endpoint and set PG_BOUNCER=true. PRISMA_CONNECTION_LIMIT keeps the pool small
# enough for provider connection caps (default 1).
#   Neon:      postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require
#   Supabase:  postgresql://postgres:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/e_library?schema=public
PRISMA_CONNECTION_LIMIT=1
PG_BOUNCER=false

# ---------------------------------------------------------------------------
# Direct connection used by `prisma db push` / `prisma migrate`.
# The runtime server does NOT need this (it queries via DATABASE_URL), but the
# Prisma CLI does, because schema.prisma declares `directUrl = env("DIRECT_URL")`.
#   - Local Postgres: set it to the same value as DATABASE_URL.
#   - Supabase:       use the session pooler (port 5432) so db push works from
#                     anywhere — the direct host is IPv6-only and the
#                     transaction pooler breaks prepared statements:
#                     postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/e_library?schema=public

# ---------------------------------------------------------------------------
# Auth (JWT)
# JWT_SECRET must be a long random string in real deployments.
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_PATH=./storage

# ---------------------------------------------------------------------------
# AI summary service (provided API). NEVER commit the real token.
# Set AI_CLIENT=fake to use a deterministic fake client (used in tests).
# ---------------------------------------------------------------------------
AI_API_BASE_URL=https://ai-api.userfacet.com
AI_API_TOKEN=
AI_MODEL=gpt-4o-mini
AI_CLIENT=real

# ---------------------------------------------------------------------------
# Open Library metadata import
# ---------------------------------------------------------------------------
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Digital loan duration (days)
# ---------------------------------------------------------------------------
LOAN_DURATION_DAYS=14
