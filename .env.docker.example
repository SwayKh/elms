# ============================================================================
# E-Library — Docker deployment environment (.env.docker.example)
#
# Usage:  cp .env.docker.example .env   (docker-compose reads `.env`)
#
# DATABASE_URL and JWT_SECRET are REQUIRED. Set both in .env before running
# `docker compose up`. Everything else has a safe default.
# ============================================================================

# --- Core ---
# JWT signing secret. REQUIRED. Use a long random string:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- Postgres (HOSTED) ---
# REQUIRED. Your hosted provider's connection string. Use the provider's
# POOLER/transaction endpoint (Neon/Supabase) and keep scheme postgresql://:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require
# Prisma pool size. Keep low (1) for hosted/serverless providers.
PRISMA_CONNECTION_LIMIT=1
# Set true when connecting through a Neon/Supabase pooler (recommended).
PG_BOUNCER=true

# --- Postgres direct (for schema operations: prisma db push / migrate) ---
# Prisma applies schema changes through `directUrl` instead of the pooler,
# because the transaction pooler breaks prepared statements. On Supabase,
# IPv6-only hosts are unreachable from Docker, so use the *session* pooler
# (port 5432 on the same pooler host) as the direct URL:
#   postgresql://postgres.<projectref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres
# (no pgbouncer flag — session mode pins a real connection)
DIRECT_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Tokens ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI book summaries ---
# Leave empty to fall back to the fake client. With a real token the app uses
# the provided API (100-call quota — summaries are cached).
AI_API_TOKEN=
AI_API_BASE_URL=https://ai-api.userfacet.com
AI_MODEL=gpt-4o-mini
AI_CLIENT=real

# --- Uploads / storage ---
# Books and covers are stored here (mounted as a Docker volume).
STORAGE_PATH=./storage

# --- Open Library import source ---
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Borrowing ---
LOAN_DURATION_DAYS=14

# --- Entrypoint (docker-compose only) ---
# Seed demo admin/user accounts on first boot. WARNING: ships default
# credentials (admin@elibrary.com / admin123456), so only use for testing.
# DB_SEED=false
