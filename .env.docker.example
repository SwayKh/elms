# ============================================================================
# E-Library — Docker deployment environment (.env.docker.example)
#
# Usage:  cp .env.docker.example .env   (docker-compose reads `.env`)
#
# With docker-compose.yml, DATABASE_URL and JWT_SECRET are *required*.
# DATABASE_URL is overridden inside the compose file to point at the bundled
# Postgres service, so you only strictly need to set JWT_SECRET (+ AI_API_TOKEN
# if you have one). Everything else has a safe default.
# ============================================================================

# --- Core ---
# JWT signing secret. REQUIRED. Use a long random string:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- Postgres ---
# (compose overrides this to postgresql://elibrary:elibrary@db:5432/e_library)
# If you use a HOSTED database instead of the bundled one, set this to your
# provider's connection string (use the pooler endpoint for Neon/Supabase).
DATABASE_URL=postgresql://elibrary:elibrary@db:5432/e_library?schema=public
# Pool size for Prisma. Keep low (1) for hosted/serverless providers.
PRISMA_CONNECTION_LIMIT=1
# Set true when connecting through a Neon/Supabase pooler.
PG_BOUNCER=false

# --- Tokens ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI book summaries ---
# Leave empty to fall back to the fake client. With a real token the app uses
# the provided API (100-call quota — summaries are cached).
AI_API_TOKEN=
AI_API_BASE_URL=https://ai-api.userfacet.com
AI_MODEL=gpt-4o-mini
AI_CLIENT=real

# --- Uploads / storage ---
# Books and covers are stored here (mounted as a Docker volume).
STORAGE_PATH=./storage

# --- Open Library import source ---
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Borrowing ---
LOAN_DURATION_DAYS=14

# --- Entrypoint (docker-compose only) ---
# Seed demo admin/user accounts on first boot. WARNING: ships default
# credentials (admin@elibrary.com / admin123456), so only use for testing.
# DB_SEED=false
