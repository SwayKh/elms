{
  "name": "userfacet-backend-project",
  "version": "1.0.0",
  "description": "E-Library Management System backend (Node.js + Express + PostgreSQL + Prisma)",
  "main": "src/server.js",
  "keywords": [
    "node",
    "express",
    "postgresql",
    "prisma",
    "e-library",
    "e-lms"
  ],
  "author": "sumit",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node scripts/test-setup.js && node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
