generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum BookFileType {
  PDF
  EPUB
}

enum LoanStatus {
  ACTIVE
  EXPIRED
}

enum SummaryType {
  SHORT
  DETAILED
}

enum SummarySource {
  METADATA
  CONTENT
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loans     DigitalLoan[]
  favorites Favorite[]
  progress  ReadingProgress[]
  bookmarks Bookmark[]
  reviews   Review[]
}

model Author {
  id        String   @id @default(cuid())
  name      String   @unique
  biography String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books BookAuthor[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books BookCategory[]
}

// A Book represents a digital literary work, NOT a physical copy.
// Do not add inventory / availability fields here.
model Book {
  id              String    @id @default(cuid())
  title           String
  description     String?
  isbn            String?   @unique
  publicationDate DateTime?
  language        String?
  publisher       String?
  coverUrl        String?
  externalSource  String?
  externalId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authors    BookAuthor[]
  categories BookCategory[]
  files      BookFile[]
  loans      DigitalLoan[]
  favorites  Favorite[]
  progress   ReadingProgress[]
  bookmarks  Bookmark[]
  reviews    Review[]
  summaries  BookSummary[]

  @@index([title])
  @@unique([externalSource, externalId])
}

model BookAuthor {
  bookId     String
  authorId   String
  assignedAt DateTime @default(now())

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
}

model BookCategory {
  bookId     String
  categoryId String
  assignedAt DateTime @default(now())

  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
}

model BookFile {
  id        String       @id @default(cuid())
  bookId    String
  filePath  String
  fileName  String?
  fileType  BookFileType
  mimeType  String?
  fileSize  Int?
  createdAt DateTime     @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

// Digital access entitlement: a user obtains permission to access a digital
// book for a period. The same book can be borrowed by many users at once.
model DigitalLoan {
  id         String     @id @default(cuid())
  userId     String
  bookId     String
  borrowedAt DateTime   @default(now())
  expiresAt  DateTime
  status     LoanStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // A user may have at most one ACTIVE loan per book. Enforced in
  // borrowing.service.js; the index below makes that lookup fast.
  @@index([userId, bookId])
  @@index([bookId])
  @@index([expiresAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  progress   Float    @default(0)
  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  location  String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, location])
  @@index([userId, bookId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
}

// Persisted / cached AI-generated summary. One cached row per
// (book, summaryType, sourceType) to avoid repeated AI calls.
model BookSummary {
  id          String        @id @default(cuid())
  bookId      String
  summary     String
  summaryType SummaryType   @default(SHORT)
  sourceType  SummarySource @default(METADATA)
  model       String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, summaryType, sourceType])
}
